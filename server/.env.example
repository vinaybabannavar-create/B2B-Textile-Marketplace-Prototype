# Server Configuration
PORT=5000

# Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# MongoDB Connection String (Optional - falls back to memory_db.json persistence if not provided)
MONGODB_URI=mongodb://127.0.0.1:27017/fabricmart

# Hugging Face AI Inference Token (Optional - enables real LLM inference for open-ended chat)
HUGGINGFACE_API_KEY=hf_your_token_here
HF_MODEL=HuggingFaceH4/zephyr-7b-beta
