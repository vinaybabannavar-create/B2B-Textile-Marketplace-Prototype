# Server Configuration
PORT=5000

# Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# MongoDB Connection String (Optional - falls back to memory_db.json persistence if not provided)
MONGODB_URI=mongodb://127.0.0.1:27017/fabricmart

# Google Gemini API Key (Optional - enables Gemini 2.5 Flash LLM conversation)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face AI Inference Token (Optional - enables Hugging Face LLM conversation)
HUGGINGFACE_API_KEY=hf_your_token_here
HF_MODEL=HuggingFaceH4/zephyr-7b-beta
